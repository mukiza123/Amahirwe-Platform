# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (e.g. from Neon: https://neon.tech)
# Format: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=postgresql://user:password@host/amahirwe?sslmode=require

# Secret used to sign JWTs. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of allowed frontend origins, or * for all (dev only)
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000,http://localhost:8000

# OAuth Client ID from Google Cloud Console (Credentials > OAuth Client ID
# > Web application). Leave blank to keep "Continue with Google" disabled.
# The same ID must also be set in frontend/js/google-auth-config.js.
GOOGLE_CLIENT_ID=

# Outbound email for verification/password-reset codes, sent via an
# authenticated Gmail account. Leave SMTP_USERNAME/PASSWORD blank to
# keep "prototype mode" (the code is returned directly in the API
# response instead of emailed — see dev_verification_code/dev_reset_code).
# To enable: turn on 2-Step Verification on the Gmail account, then
# generate an App Password at https://myaccount.google.com/apppasswords
# (NOT your normal Gmail password) and paste it below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=Amahirwe
